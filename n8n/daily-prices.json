      "parameters": {
        "jsCode": "// רשת שכבר התעדכנה היום (שעון ישראל) מדולגת\nconst day = (t) => new Date(t).toLocaleDateString('en-CA', { timeZone: 'Asia/Jerusalem' });\nconst today = day(Date.now());\nconst latest = {};\nfor (const i of $input.all()) if (i.json.chain_id) latest[i.json.chain_id] = i.json.loaded_at;\nreturn $('בין 09:00 ל-18:00?').all()\n  .filter((i) => !latest[i.json.chain] || day(latest[i.json.chain]) !== today)\n  .map((i) => ({ json: { chain: i.json.chain, last: latest[i.json.chain] || null } }));"
