        "jsCode": "const r = $input.first().json;\nconst prev = $('טיב טעם: אסימון כניסה').first().json.cookie;\nconst sc = [].concat(r.headers['set-cookie'] || []).map((c) => c.split(';')[0]);\nconst jar = {};\nfor (const c of prev.split('; ').concat(sc)) { const [k, ...v] = c.split('='); if (k) jar[k] = v.join('='); }\nconst location = r.headers.location || '';\nif (location.includes('login')) throw new Error('הכניסה ל-Cerberus נכשלה. בדוק את ה-Credential של טיב טעם');\nreturn [{ json: { cookie: Object.entries(jar).map(([k, v]) => k + '=' + v).join('; ') } }];"
