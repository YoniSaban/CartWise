        0
      ],
      "parameters": {
        "jsCode": "// קורא את קובץ ה-PriceFull, מסנן מוצרים במשקל, ומחלק למנות של 1,000\n// חוץ מהמוצרים במשקל שבסל (WEIGHTED): הם נשמרים, עם מחיר לק\"ג ב-price_per_kg\nconst WEIGHTED = new Set([\n  '7290000964775', // בננות\n  '7290000000480', // בצל יבש\n  '7290000000138', // כרוב לבן\n  '7290000000046', // מלפפונים\n  '7290000000022', // עגבניות\n  '7290000000091', // פלפל אדום\n  '7290000000596', // תפוחי אדמה\n  '7290009137507', // תפוחי עץ גרני סמית\n  '7290000933740', // בשר בקר טחון\n  '7290009011043', // פילה אמנון\n  '7290000616827', // חזה עוף\n  '7290001303436', // עוף שלם טרי\n]);\nconst xml = $input.first().json.data;\nconst loadedAt = new Date().toISOString();\nconst seen = new Set();\nconst rows = [];\nconst re = /<Item>([\\s\\S]*?)<\\/Item>/g;\nlet m;\nwhile ((m = re.exec(xml))) {\n  const s = m[1];\n  const g = (t) => {\n    const r = s.match(new RegExp('<' + t + '>([\\\\s\\\\S]*?)</' + t + '>', 'i'));\n    return r ? r[1].trim() : '';\n  };\n  const code = g('ItemCode');\n  const price = parseFloat(g('ItemPrice'));\n  const weighted = (g('bIsWeighted') || g('blsWeighted')) === '1';\n  const kg = WEIGHTED.has(code);\n  if (!code || (weighted && !kg) || !(price > 0) || seen.has(code)) continue;\n  // מוצר במשקל: המחיר בקובץ הוא לק\"ג. אריזה במשקל משוער (וולט): המחיר חלקי משקל האריזה\n  let perKg = null;\n  if (kg) {\n    const q = parseFloat(g('Quantity'));\n    const unitQty = g('UnitQty');\n    const kgInPack = /קילו|ק\"ג/.test(unitQty) ? q : /גרם/.test(unitQty) ? q / 1000 : null;\n    perKg = weighted ? price : kgInPack > 0 ? Math.round((price / kgInPack) * 100) / 100 : null;\n  }\n  seen.add(code);\n  const updated = g('PriceUpdateTime').replace(' ', 'T');\n  rows.push({\n    chain_id: 'shufersal',\n    item_code: code,\n    item_name: g('ItemName').replace(/\\s+/g, ' '),\n    manufacturer: g('ManufactureName') || null,\n    quantity: parseFloat(g('Quantity')) || null,\n    unit: g('UnitOfMeasure') || g('UnitQty') || null,\n    price,\n    price_per_kg: perKg,\n    price_updated_at: updated || null,\n    loaded_at: loadedAt,\n  });\n}\nif (rows.length < 1000) throw new Error('נמצאו רק ' + rows.length + ' מוצרים בקובץ. לא כותבים כלום.');\n// קוד של מוצר במשקל שלא נמצא בקובץ: המוצר יופיע כחסר ברשת. הרשימה נשמרת ביומן ההרצה\nconst missingWeighted = [...WEIGHTED].filter((c) => !seen.has(c));\nif (missingWeighted.length) console.log('שופרסל: מוצרים במשקל שלא נמצאו:', missingWeighted.join(', '));\nconst batches = [];\nfor (let i = 0; i < rows.length; i += 1000) batches.push({ json: { rows: rows.slice(i, i + 1000) } });\nif (batches.length) batches[0].json.missing_weighted = missingWeighted;\nreturn batches;"
      },
