        "jsCode": "// קורא את קובץ ה-PriceFull, מסנן מוצרים במשקל, ומחלק למנות של 1,000\nconst xml = $input.first().json.data;\nconst loadedAt = new Date().toISOString();\nconst seen = new Set();\nconst rows = [];\nconst re = /<Item>([\\s\\S]*?)<\\/Item>/g;\nlet m;\nwhile ((m = re.exec(xml))) {\n  const s = m[1];\n  const g = (t) => {\n    const r = s.match(new RegExp('<' + t + '>([\\\\s\\\\S]*?)</' + t + '>', 'i'));\n    return r ? r[1].trim() : '';\n  };\n  const code = g('ItemCode');\n  const price = parseFloat(g('ItemPrice'));\n  const weighted = (g('bIsWeighted') || g('blsWeighted')) === '1';\n  if (!code || weighted || !(price > 0) || seen.has(code)) continue;\n  seen.add(code);\n  const updated = g('PriceUpdateTime').replace(' ', 'T');\n  rows.push({\n    chain_id: 'tiv_taam',\n    item_code: code,\n    item_name: g('ItemName').replace(/\\s+/g, ' '),\n    manufacturer: g('ManufactureName') || null,\n    quantity: parseFloat(g('Quantity')) || null,\n    unit: g('UnitOfMeasure') || g('UnitQty') || null,\n    price,\n    price_updated_at: updated || null,\n    loaded_at: loadedAt,\n  });\n}\nif (rows.length < 100) throw new Error('נמצאו רק ' + rows.length + ' מוצרים בקובץ. לא כותבים כלום.');\nconst batches = [];\nfor (let i = 0; i < rows.length; i += 1000) batches.push({ json: { rows: rows.slice(i, i + 1000) } });\nreturn batches;"
      }
