        "jsCode": "// מחוץ ל-09:00 עד 18:00 שעון ישראל לא עושים כלום. אחרת, פריט לכל רשת\nconst hour = Number(new Date().toLocaleString('en-US', { timeZone: 'Asia/Jerusalem', hour: '2-digit', hour12: false }));\nif (hour < 9 || hour >= 18) return [];\nreturn ['shufersal', 'wolt', 'tiv_taam'].map((chain) => ({ json: { chain } }));"
