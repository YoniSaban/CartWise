        "jsCode": "const xml = $input.first().json.data;\nconst stores = [...xml.matchAll(/<Store>([\\s\\S]*?)<\\/Store>/gi)].map((m) => {\n  const g = (t) => ((m[1].match(new RegExp('<' + t + '>([^<]*)</' + t + '>', 'i')) || [])[1] || '').trim();\n  return { json: { store_id: g('StoreID'), name: g('StoreName'), city: g('City'), address: g('Address') } };\n});\nreturn stores;"
